SX1276 Rev. 7, 4.1.1.7 : Ts = 2^SF/BW ; Tpre = (npre + 4,25) Ts ;
Npayload = 8 + max(ceil((8PL - 4SF + 28 + 16CRC - 20IH) / (4(SF - 2DE))) (CR + 4), 0)
attente = ToA / 1 % - ToA ; msg/h = floor(36 s / ToA) ; msg/j FUP = floor(30 s / ToA)

