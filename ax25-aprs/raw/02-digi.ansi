$ cat digi.conf
ADEVICE stdin null
ARATE 44100
CHANNEL 0
MYCALL N0CALL-1
MODEM 1200
DIGIPEAT 0 0 ^WIDE[3-7]-[1-7]$ ^WIDE[12]-[12]$
(exit 0)
